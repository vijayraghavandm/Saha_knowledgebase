{
  "name": "saha-knowledge-review-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Meeting prototype: internal review tool for a disease-specific caregiving knowledge template. Synthetic/draft content. Not for patient care.",
  "type": "module",
  "scripts": {
    "dev": "vite",
